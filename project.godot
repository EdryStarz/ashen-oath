; Ashen Oath — native Godot application, no web runtime.
config_version=5

[application]
config/name="Пепельный обет"
config/version="0.7.2"
config/description="Твои реальные действия меняют исход охоты."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/store_icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="AshenOath"

[display]
window/size/viewport_width=432
window/size/viewport_height=900
window/size/window_width_override=432
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.047, 0.063, 0.067, 1)
textures/vram_compression/import_etc2_astc=true

[audio]
driver/enable_input=false

[application_run]
low_processor_mode=true
